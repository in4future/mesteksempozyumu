---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { ulasimVeKonaklama, siteConfig } from '../data/siteData';

const { ulasim, konaklama } = ulasimVeKonaklama;
---

<Layout title="Ulaşım ve Konaklama">
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-[#0B2545] to-[#134074] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <nav class="flex items-center gap-2 text-xs sm:text-sm text-blue-200 mb-3" aria-label="Ekmek Kırıntısı">
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
            <Icon name="chevron-right" class="w-3.5 h-3.5" />
            <span class="text-white">Ulaşım ve Konaklama</span>
          </nav>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Ulaşım ve Konaklama</h1>
          <p class="mt-2 text-blue-100 text-sm sm:text-base max-w-2xl">
            MESTEK'26 Sempozyum alanına (Gazi Üniversitesi Beşevler Kampüsü) ulaşım seçenekleri ve tavsiye edilen konaklama imkanları.
          </p>
        </div>
        <div class="shrink-0 bg-white/10 p-3 rounded-xl border border-white/20 hidden md:block">
          <Icon name="navigation" class="w-10 h-10 text-blue-200" />
        </div>
      </div>
    </div>
  </section>

  <!-- Page Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section 1: Ulaşım Rehberi -->
      <div class="space-y-10">
        <div class="border-b border-slate-100 pb-5">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0B2545]">Gazi Üniversitesi'ne Ulaşım</h2>
          <p class="mt-2 text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl">
            Sempozyumumuz Gazi Üniversitesi Beşevler Yerleşkesi (Teknoloji Fakültesi / Rektörlük) bünyesinde gerçekleştirilecektir. Otogardan ve havalimanından yerleşkeye ulaşım bilgileri aşağıda yer almaktadır.
          </p>
        </div>

        <!-- AŞTİ (Otogar) Ulaşımı -->
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-[#0B2545]/5 text-[#0B2545] rounded-xl shrink-0">
              <Icon name="bus" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-[#0B2545]">{ulasim.asti.title}</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {ulasim.asti.options.map((option) => (
              <div class="p-6 bg-slate-50 border border-slate-100 hover:border-blue-200 rounded-2xl transition-all shadow-sm flex flex-col justify-between space-y-4">
                <div class="space-y-3">
                  <div class="flex items-center justify-between gap-2">
                    <h4 class="font-bold text-[#0B2545] text-base">{option.title}</h4>
                    {option.badge && (
                      <span class="px-2.5 py-0.5 text-xs font-semibold rounded-md bg-blue-100 text-[#0B2545]">
                        {option.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    {option.description}
                  </p>
                </div>
                <div class="pt-3 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-slate-500">
                  <Icon name="clock" class="w-4 h-4 text-[#0B2545]" />
                  <span>Süre: {option.duration}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Esenboğa Havalimanı Ulaşımı -->
        <div class="space-y-6 pt-4">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-[#0B2545]/5 text-[#0B2545] rounded-xl shrink-0">
              <Icon name="plane" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-[#0B2545]">{ulasim.havalimani.title}</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {ulasim.havalimani.options.map((option) => (
              <div class="p-6 bg-slate-50 border border-slate-100 hover:border-blue-200 rounded-2xl transition-all shadow-sm flex flex-col justify-between space-y-4">
                <div class="space-y-3">
                  <div class="flex items-center justify-between gap-2">
                    <h4 class="font-bold text-[#0B2545] text-base">{option.title}</h4>
                    {option.badge && (
                      <span class="px-2.5 py-0.5 text-xs font-semibold rounded-md bg-blue-100 text-[#0B2545]">
                        {option.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    {option.description}
                  </p>
                </div>
                <div class="pt-3 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-slate-500">
                  <Icon name="clock" class="w-4 h-4 text-[#0B2545]" />
                  <span>Süre: {option.duration}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Kampüs Konumu Bilgisi -->
        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div class="space-y-1">
            <h4 class="font-bold text-[#0B2545] text-sm flex items-center gap-2">
              <Icon name="map-pin" class="w-5 h-5 text-blue-600" />
              <span>Gazi Üniversitesi Beşevler Yerleşkesi</span>
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {siteConfig.contact.address} (Ankaray Beşevler durağına 5 dakika yürüme mesafesinde)
            </p>
          </div>
          <a
            href="https://maps.google.com/?q=Gazi+%C3%9Cniversitesi+Teknoloji+Fak%C3%BCltesi+Ankara"
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-2 bg-[#0B2545] text-white hover:bg-[#134074] font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-colors shadow-sm"
          >
            <Icon name="globe" class="w-4 h-4" />
            <span>Haritada Göster</span>
          </a>
        </div>

      </div>

      <!-- Section 2: Konaklama Tavsiyeleri -->
      <div class="space-y-8 pt-6 border-t border-slate-100">
        <div class="border-b border-slate-100 pb-5">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0B2545]">{konaklama.title}</h2>
          <p class="mt-2 text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl">
            {konaklama.subtitle}
          </p>
        </div>

        <!-- Bilgilendirme Kutusu (Önemli Not) -->
        <div class="bg-rose-50/70 border border-rose-200/80 rounded-2xl px-6 py-5 sm:px-8 sm:py-6 flex items-start gap-4 shadow-2xs">
          <div class="p-2 bg-rose-100/80 text-rose-700 rounded-xl shrink-0 mt-0.5">
            <Icon name="info" class="w-5 h-5" />
          </div>
          <div class="space-y-1">
            <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-rose-800">Önemli Bilgilendirme</h4>
            <p class="text-xs sm:text-sm text-rose-900/90 leading-relaxed font-medium">
              {konaklama.notice}
            </p>
          </div>
        </div>

        <!-- Konaklama Tesisleri Kartları -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {konaklama.places.map((place) => (
            <div class="bg-slate-50 border border-slate-100 hover:border-blue-200 rounded-2xl p-6 sm:p-8 transition-all shadow-sm flex flex-col justify-between space-y-6">
              
              <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="px-3 py-1 bg-blue-100 text-[#0B2545] font-bold text-xs rounded-lg">
                    {place.tag}
                  </span>
                  <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
                    {place.distance}
                  </span>
                </div>

                <div class="space-y-2">
                  <h3 class="text-xl font-bold text-[#0B2545]">{place.name}</h3>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    {place.description}
                  </p>
                </div>

                {place.note && (
                  <div class="p-3.5 bg-amber-50/80 border border-amber-200 rounded-xl flex items-start gap-2.5 text-xs text-amber-900 shadow-2xs">
                    <Icon name="info" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
                    <span class="font-semibold">{place.note}</span>
                  </div>
                )}

                <!-- Imkanlar -->
                <div class="flex flex-wrap gap-2 pt-1">
                  {place.features.map((feature) => (
                    <span class="text-[11px] font-medium bg-white text-slate-600 px-2.5 py-1 rounded-md border border-slate-200">
                      ✓ {feature}
                    </span>
                  ))}
                </div>

                <!-- Adres & Telefon -->
                <div class="space-y-2.5 pt-4 border-t border-slate-200/60 text-xs sm:text-sm text-slate-600">
                  <div class="flex items-start gap-2.5">
                    <Icon name="map-pin" class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
                    <span>{place.address}</span>
                  </div>
                  <div class="flex items-center gap-2.5">
                    <Icon name="phone" class="w-4 h-4 text-slate-400 shrink-0" />
                    <a href={`tel:${place.phone.replace(/[^0-9]/g, '')}`} class="font-bold text-[#0B2545] hover:underline">
                      {place.phone}
                    </a>
                  </div>
                </div>
              </div>

              <!-- Butonlar -->
              <div class="pt-4 border-t border-slate-200/60 flex flex-wrap items-center gap-3">
                {place.website && (
                  <a
                    href={place.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-[#0B2545] text-white hover:bg-[#134074] font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-colors shadow-sm"
                  >
                    <Icon name="globe" class="w-4 h-4" />
                    <span>Web Sitesi</span>
                  </a>
                )}
                {place.mapsUrl && (
                  <a
                    href={place.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-white text-slate-700 hover:text-[#0B2545] border border-slate-200 font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-colors"
                  >
                    <Icon name="map-pin" class="w-4 h-4 text-slate-500" />
                    <span>Konumu Gör</span>
                  </a>
                )}
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
