---
import { sponsors } from '../data/siteData';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const row1 = sponsors.slice(0, 4);
const row2 = sponsors.slice(4, 8);
const row3 = sponsors.slice(8, 10);
---

<!-- Sponsorlar Section -->
<section class={`py-20 bg-slate-50 border-t border-slate-100 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold text-[#134074] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full border border-blue-100 inline-block mb-3">Katkılarıyla</span>
      <h2 class="text-3xl font-extrabold text-[#0B2545] tracking-tight">Sponsorlarımız</h2>
      <p class="mt-3 text-slate-600 text-base sm:text-lg">
        Sempozyumumuza destek sağlayan kurum ve kuruluşlar.
      </p>
    </div>

    <div class="space-y-6 max-w-6xl mx-auto">
      <!-- 1. Satır (4 Sponsor) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {row1.map((sponsor) => {
          const hasLink = Boolean(sponsor.website && sponsor.website.trim() !== "" && sponsor.website !== "#");
          return hasLink ? (
            <a 
              href={sponsor.website} 
              target="_blank" 
              rel="noopener noreferrer" 
              title={sponsor.name}
              class="group relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-300 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center h-32 w-full"
            >
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} Logo`} 
                class="max-h-16 max-w-[170px] w-auto object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </a>
          ) : (
            <div 
              title={sponsor.name}
              class="relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow duration-300 flex items-center justify-center h-32 w-full select-none"
            >
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} Logo`} 
                class="max-h-16 max-w-[170px] w-auto object-contain"
              />
            </div>
          );
        })}
      </div>

      <!-- 2. Satır (4 Sponsor) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {row2.map((sponsor) => {
          const hasLink = Boolean(sponsor.website && sponsor.website.trim() !== "" && sponsor.website !== "#");
          return hasLink ? (
            <a 
              href={sponsor.website} 
              target="_blank" 
              rel="noopener noreferrer" 
              title={sponsor.name}
              class="group relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-300 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center h-32 w-full"
            >
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} Logo`} 
                class="max-h-16 max-w-[170px] w-auto object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </a>
          ) : (
            <div 
              title={sponsor.name}
              class="relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow duration-300 flex items-center justify-center h-32 w-full select-none"
            >
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} Logo`} 
                class="max-h-16 max-w-[170px] w-auto object-contain"
              />
            </div>
          );
        })}
      </div>

      <!-- 3. Satır (2 Sponsor - Ortalı) -->
      <div class="flex justify-center gap-6">
        {row3.map((sponsor) => {
          const hasLink = Boolean(sponsor.website && sponsor.website.trim() !== "" && sponsor.website !== "#");
          return (
            <div class="w-[calc(50%-12px)] md:w-[calc(25%-18px)]">
              {hasLink ? (
                <a 
                  href={sponsor.website} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  title={sponsor.name}
                  class="group relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-300 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center h-32 w-full"
                >
                  <img 
                    src={sponsor.logo} 
                    alt={`${sponsor.name} Logo`} 
                    class="max-h-16 max-w-[170px] w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                </a>
              ) : (
                <div 
                  title={sponsor.name}
                  class="relative bg-white py-5 px-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow duration-300 flex items-center justify-center h-32 w-full select-none"
                >
                  <img 
                    src={sponsor.logo} 
                    alt={`${sponsor.name} Logo`} 
                    class="max-h-16 max-w-[170px] w-auto object-contain"
                  />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
