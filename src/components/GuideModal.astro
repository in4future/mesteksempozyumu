---
import Icon from './Icon.astro';
---

<div 
  id="guide-modal" 
  class="fixed inset-0 z-[120] flex items-center justify-center p-3 sm:p-4 md:p-6 bg-slate-950/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-6xl w-full max-h-[94vh] sm:max-h-[92vh] flex flex-col overflow-hidden transform scale-95 transition-all duration-300 border border-slate-200">
    
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-[#0B2545] via-[#134074] to-[#1E3A8A] text-white px-6 py-5 flex items-center justify-between shadow-md shrink-0 relative z-10">
      <div class="space-y-1 pr-4">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider bg-blue-400/20 text-blue-200 border border-blue-300/30">Kullanım Rehberi</span>
        </div>
        <h2 id="modal-title" class="text-lg sm:text-xl md:text-2xl font-extrabold tracking-tight text-white leading-tight">
          MESTEK’26 BİLDİRİ GÖNDERİM SİSTEMİ KULLANIM REHBERİ
        </h2>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a 
          href="https://mestek2026kongre.projesi.com.tr/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md transition-all duration-200 hover:scale-105 active:scale-95"
        >
          <span>Sisteme Git</span>
          <Icon name="external-link" class="w-3.5 h-3.5" />
        </a>
        <button 
          id="close-guide-btn" 
          type="button" 
          class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-white/50"
          aria-label="Rehberi Kapat"
        >
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Subtitle Banner -->
    <div class="bg-blue-50 border-b border-blue-100 px-6 py-3 text-xs sm:text-sm font-medium text-slate-700 flex items-center gap-2 shrink-0">
      <Icon name="info" class="w-4 h-4 text-blue-600 shrink-0" />
      <span>MESTEK’26 kapsamında bildiri göndermek için aşağıdaki adımları takip edebilirsiniz.</span>
    </div>

    <!-- Modal Scrollable Content -->
    <div class="overflow-y-auto p-4 sm:p-6 md:p-8 space-y-8 bg-slate-50/50 flex-grow scroll-smooth custom-scrollbar">
      
      <!-- Step 1 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">1</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Bildiri Gönderim Sistemine Giriş</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              MESTEK’26 web sitesinde yer alan <strong>“Bildiri Gönder”</strong> butonuna tıklayarak bildiri gönderim sistemine giriş yapınız.
            </p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-1.jpg" 
            alt="Bildiri Gönderim Sistemine Giriş" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">2</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Tam Metin Gönderim Sistemine Geçiş</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              “Bildiri Gönder” butonuna tıkladıktan sonra açılan “Tam Metin Gönderimi” sayfasında, sağ tarafta bulunan ok simgesine tıklayarak bildiri gönderim sistemine devam ediniz.
            </p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-2.jpg" 
            alt="Tam Metin Gönderim Sistemine Geçiş" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">3</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Dil Seçiminizi Yapınız 🌐</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Açılan ekrandan kullanmak istediğiniz dili seçerek sisteme devam ediniz. 
              <a href="https://mestek2026kongre.projesi.com.tr/dil.aspx" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-semibold ml-1 inline-flex items-center gap-1">
                <span>mestek2026kongre.projesi.com.tr/dil.aspx</span>
                <Icon name="external-link" class="w-3 h-3" />
              </a>
            </p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-3.jpg" 
            alt="Dil Seçimi" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 4 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-5 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">4</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Sisteme Üye Olunuz 👤</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              İlk kez giriş yapıyorsanız <strong>“Yeni Üyelik”</strong> seçeneğini kullanarak üyelik kaydınızı oluşturunuz.
            </p>
          </div>
        </div>

        <!-- Image 4 -->
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-4.jpg" 
            alt="Yeni Üyelik Seçimi" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pt-2">
          Kişisel ve akademik bilgilerinizi eksiksiz olarak doldurarak üyelik işleminizi tamamlayınız. Dr. unvanına sahip kullanıcılarımız, hakem olarak görev almak istemeleri hâlinde <strong>“Hakem olmak istiyorum”</strong> seçeneğini işaretleyebilirler. Ardından <strong>“Kayıt Ol”</strong> butonuna tıklayarak üyelik işlemini tamamlayınız.
        </p>

        <!-- Image 5 -->
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-5.jpg" 
            alt="Üyelik Formu Tamamlama" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 5 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">5</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Sisteme Giriş Yapınız 🔐</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Üyelik işleminizi tamamladıktan sonra e-posta adresiniz ve şifreniz ile sisteme giriş yapınız.
            </p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-6.png" 
            alt="Sisteme Giriş" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 6 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-5 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">6</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Bildiri Kaydı Oluşturunuz 📝</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Sisteme giriş yaptıktan sonra <strong>“Bildiri Sistemi”</strong> menüsünde yer alan <strong>“Yeni Bildiri Kaydı”</strong> sekmesine tıklayarak bildiri kaydınızı oluşturunuz. Bildiri başlığı, yazar bilgileri ve sistem tarafından talep edilen diğer bilgileri eksiksiz olarak giriniz.
            </p>
          </div>
        </div>

        <!-- Images 7, 8, 9 Stacked Vertically -->
        <div class="flex flex-col gap-4">
          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
            <img 
              src="/klavuz/klavuz-7.jpg" 
              alt="Yeni Bildiri Kaydı Sekmesi" 
              class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
              loading="lazy"
            />
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
            <img 
              src="/klavuz/klavuz-8.png" 
              alt="Bildiri Detayları ve Yazarlar" 
              class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
              loading="lazy"
            />
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
            <img 
              src="/klavuz/klavuz-9.jpg" 
              alt="Bildiri Bilgilerini Girme" 
              class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
              loading="lazy"
            />
          </div>
        </div>

        <div class="space-y-2 text-xs sm:text-sm text-slate-600 leading-relaxed pt-2">
          <p>
            Sempozyumumuzda yalnızca tam metin bildiriler kabul edildiğinden <strong>“Tam Metin Göndereceğim”</strong> seçeneğini işaretleyiniz. İlgili alanları eksiksiz olarak doldurduktan sonra <strong>“Kaydet”</strong> butonuna tıklayınız.
          </p>
          <p>
            Bildiri kaydınızın başarıyla oluşturulduğuna ilişkin bilgilendirme ekranı görüntülendiğinde <strong>“OK”</strong> butonuna tıklayarak devam ediniz.
          </p>
        </div>

        <!-- Image 10 -->
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-10.png" 
            alt="Kayıt Başarılı Bildirimi" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Step 7 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">7</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Tam Metninizi Yükleyiniz 📄</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Bildiri kaydınızı oluşturduktan sonra MESTEK’26 yazım şablonuna uygun olarak hazırladığınız tam metin dosyanızı ve benzerlik raporunuzu sisteme yükleyiniz.
            </p>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-11.jpg" 
            alt="Tam Metin Dosyası Yükleme" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Dosyanızı yükledikten sonra bilgilerinizi kontrol ederek gönderim işlemini tamamlayınız.
        </p>
      </div>

      <!-- Step 8 -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-sm space-y-4 hover:border-blue-300 transition-colors">
        <div class="flex items-start gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#0B2545] text-white font-bold text-sm shrink-0 shadow-sm">8</span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0B2545]">Gönderiminizi Kontrol Ediniz ✅</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Gönderim işleminizi tamamladıktan sonra bildirinizin sistemde kayıtlı olduğunu ve <strong>“Tam Metin”</strong> sekmesinden tam metin dosyanızın başarıyla yüklendiğini kontrol ediniz. Bildirinizin değerlendirme sürecini sistem üzerinden takip edebilirsiniz.
            </p>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shadow-inner group">
          <img 
            src="/klavuz/klavuz-12.png" 
            alt="Gönderim Kontrolü ve Takip" 
            class="w-full h-auto object-contain cursor-zoom-in group-hover:scale-[1.01] transition-transform duration-300 guide-img" 
            loading="lazy"
          />
        </div>
      </div>

      <!-- Bottom Prominent CTA Box -->
      <div class="bg-gradient-to-br from-[#0B2545] via-[#134074] to-[#1E3A8A] text-white rounded-2xl p-6 sm:p-8 text-center space-y-4 shadow-xl border border-blue-400/30 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 w-48 h-48 bg-blue-400/20 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -left-12 -bottom-12 w-48 h-48 bg-emerald-400/20 rounded-full blur-2xl pointer-events-none"></div>
        
        <div class="relative z-10 space-y-3">
          <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-wider">
            Rehberi Tamamladınız
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">
            MESTEK'26 Bildiri Gönderim Sistemine Bağlanmaya Hazırsınız!
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 max-w-xl mx-auto leading-relaxed">
            Aşağıdaki butona tıklayarak bildiri yönetim sistemine geçiş yapabilir, yeni üyeliğinizi oluşturup bildirilerinizi hemen sisteme yükleyebilirsiniz.
          </p>

          <div class="pt-4 flex justify-center">
            <a 
              href="https://mestek2026kongre.projesi.com.tr/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-3 bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-400 hover:to-teal-500 text-white font-extrabold text-sm sm:text-base px-8 py-4 rounded-xl shadow-lg hover:shadow-emerald-500/25 transition-all duration-300 hover:scale-105 active:scale-95 border border-emerald-300/40 group"
            >
              <Icon name="send" class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" />
              <span>BİLDİRİ GÖNDERİM SİSTEMİNE GİT</span>
              <Icon name="external-link" class="w-4 h-4 opacity-90" />
            </a>
          </div>
          <p class="text-[11px] text-blue-200/70 pt-1">
            Link: <span class="font-mono underline">https://mestek2026kongre.projesi.com.tr/</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Modal Footer Controls -->
    <div class="px-6 py-4 bg-white border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 shrink-0">
      <p class="text-xs text-slate-500 text-center sm:text-left">
        Görsellere tıklayarak daha büyük boyutta inceleyebilirsiniz.
      </p>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button 
          id="close-guide-footer-btn" 
          type="button" 
          class="w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 font-bold text-xs sm:text-sm rounded-xl transition-colors duration-150"
        >
          Kapat
        </button>

        <a 
          href="https://mestek2026kongre.projesi.com.tr/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#0B2545] hover:bg-[#134074] text-white font-bold text-xs sm:text-sm px-6 py-2.5 rounded-xl shadow transition-all duration-150"
        >
          <span>Sisteme Git</span>
          <Icon name="external-link" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</div>

<!-- Image Lightbox Modal for zooming screenshots -->
<div 
  id="guide-lightbox" 
  class="fixed inset-0 z-[140] flex items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
>
  <button 
    id="close-lightbox-btn" 
    type="button" 
    class="absolute top-4 right-4 z-10 p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors focus:outline-none"
    aria-label="Görseli Kapat"
  >
    <Icon name="x" class="w-6 h-6" />
  </button>
  <div class="max-w-5xl max-h-[90vh] overflow-hidden flex flex-col items-center">
    <img id="lightbox-img" src="" alt="Büyütülmüş Görsel" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl" />
    <p id="lightbox-caption" class="text-white text-xs sm:text-sm mt-3 font-medium text-center bg-black/50 px-4 py-1.5 rounded-full"></p>
  </div>
</div>

<script>
  function setupGuideModal() {
    const guideModal = document.getElementById('guide-modal');
    const closeBtn = document.getElementById('close-guide-btn');
    const closeFooterBtn = document.getElementById('close-guide-footer-btn');

    // Lightbox elements
    const lightbox = document.getElementById('guide-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeLightboxBtn = document.getElementById('close-lightbox-btn');

    function openModal() {
      if (!guideModal) return;
      guideModal.classList.remove('opacity-0', 'pointer-events-none');
      const container = guideModal.querySelector('.transform');
      container?.classList.remove('scale-95');
      container?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!guideModal) return;
      guideModal.classList.add('opacity-0', 'pointer-events-none');
      const container = guideModal.querySelector('.transform');
      container?.classList.remove('scale-100');
      container?.classList.add('scale-95');
      document.body.style.overflow = '';
    }

    // Bind triggers with attribute data-open-guide-modal or class .open-guide-modal
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const trigger = target?.closest('[data-open-guide-modal], .open-guide-modal');
      if (trigger) {
        e.preventDefault();
        openModal();
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    closeFooterBtn?.addEventListener('click', closeModal);

    guideModal?.addEventListener('click', (e) => {
      if (e.target === guideModal) {
        closeModal();
      }
    });

    // Handle Image Clicks inside Guide Modal for Lightbox Zooming
    const guideImgs = document.querySelectorAll('.guide-img');
    guideImgs.forEach((img) => {
      img.addEventListener('click', () => {
        const imageElement = img as HTMLImageElement;
        if (lightbox && lightboxImg) {
          lightboxImg.src = imageElement.src;
          lightboxImg.alt = imageElement.alt;
          if (lightboxCaption) {
            lightboxCaption.textContent = imageElement.alt;
          }
          lightbox.classList.remove('opacity-0', 'pointer-events-none');
        }
      });
    });

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    closeLightboxBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (lightbox && !lightbox.classList.contains('pointer-events-none')) {
          closeLightbox();
        } else if (guideModal && !guideModal.classList.contains('pointer-events-none')) {
          closeModal();
        }
      }
    });
  }

  // Initialize script on DOMContentLoaded or immediate execution
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuideModal);
  } else {
    setupGuideModal();
  }
